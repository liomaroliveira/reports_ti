#!/usr/bin/env bash
# Bloqueia commits com dados sensíveis (LGPD e segredos).
# Ativação (uma vez por clone): git config core.hooksPath .githooks

fail=0

# 1. Arquivos do WhatsApp que não sejam README/scripts
bad_paths=$(git diff --cached --name-only --diff-filter=AM \
  | grep -E '^miscelaneous/whatsapp_histories/' \
  | grep -vE '^miscelaneous/whatsapp_histories/(README\.md|scripts/[^/]+\.py)$')
if [ -n "$bad_paths" ]; then
  echo "[BLOQUEADO] Dados do WhatsApp não podem ser versionados:"
  echo "$bad_paths" | sed 's/^/  /'
  fail=1
fi

# 2. Conteúdo adicionado: CPF sem máscara, chaves de API e chave de 64 dígitos
pattern='[0-9]{3}\.[0-9]{3}\.[0-9]{3}-[0-9]{2}|sk-[A-Za-z0-9_-]{16,}|\b[0-9a-f]{64}\b'
hits=$(git diff --cached -U0 --diff-filter=AM -- . ':(exclude)*.pdf' \
  | grep -E '^\+[^+]' | grep -oE "$pattern" | sort -u | head -5)
if [ -n "$hits" ]; then
  echo "[BLOQUEADO] Conteúdo sensível encontrado nas linhas adicionadas (amostra):"
  echo "$hits" | sed -E 's/^(.{6}).*/  \1…/'
  echo "  CPFs: python3 scripts/mascarar_dados.py <arquivos>   |   Chaves: remova do arquivo."
  fail=1
fi

# 3. PDFs com CPF sem máscara (requer pdftotext)
if command -v pdftotext >/dev/null 2>&1; then
  while IFS= read -r pdf; do
    [ -z "$pdf" ] && continue
    if git show ":$pdf" | pdftotext -q - - 2>/dev/null | grep -qE '[0-9]{3}\.[0-9]{3}\.[0-9]{3}-[0-9]{2}'; then
      echo "[BLOQUEADO] PDF com CPF sem máscara: $pdf (gere o PDF a partir do HTML/CSV mascarado)"
      fail=1
    fi
  done < <(git diff --cached --name-only --diff-filter=AM -- '*.pdf')
fi

if [ $fail -ne 0 ]; then
  echo "Commit cancelado. Para ignorar conscientemente: git commit --no-verify"
fi
exit $fail
