#!/usr/bin/env bash
# Bloqueia commits com segredos de infraestrutura (chaves de API) e dados do WhatsApp.
# Dados pessoais e credenciais em relatos (CPF/CNPJ, e-mail, RTMP, senha) geram apenas AVISO:
# o repositório é de uso interno da empresa (decisão de 2026-10-19). Mascarar com scripts/mascarar_dados.py quando possível.
# Ativação (uma vez por clone): git config core.hooksPath .githooks

fail=0
avisos=

# 1. Arquivos do WhatsApp que não sejam README/scripts
bad_paths=$(git diff --cached --name-only --diff-filter=AM \
  | grep -E '^miscelaneous/whatsapp_histories/' \
  | grep -vE '^miscelaneous/whatsapp_histories/(README\.md|scripts/[^/]+\.py)$')
if [ -n "$bad_paths" ]; then
  echo "[BLOQUEADO] Dados do WhatsApp não podem ser versionados:"
  echo "$bad_paths" | sed 's/^/  /'
  fail=1
fi

# 2. Chaves de API e chave de 64 dígitos nas linhas adicionadas
pattern='sk-[A-Za-z0-9_-]{16,}|\b[0-9a-f]{64}\b'
hits=$(git diff --cached -U0 --diff-filter=AM -- . ':(exclude)*.pdf' \
  | grep -E '^\+[^+]' | grep -oE "$pattern" | sort -u | head -5)
if [ -n "$hits" ]; then
  echo "[BLOQUEADO] Chave/segredo encontrado nas linhas adicionadas (amostra):"
  echo "$hits" | sed -E 's/^(.{6}).*/  \1…/'
  fail=1
fi

# 3. AVISO (não bloqueia): dados pessoais e credenciais (CPF/CNPJ com ou sem pontuação, e-mail de cliente,
#    RTMP, senha) nos arquivos de texto e PDFs adicionados/alterados. Mesma detecção de scripts/mascarar_dados.py.
mascara="$(git rev-parse --show-toplevel)/scripts/mascarar_dados.py"
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    *.md|*.html|*.htm|*.csv|*.txt|*.json) conteudo=$(git show ":$f") ;;
    *.pdf) command -v pdftotext >/dev/null 2>&1 || continue; conteudo=$(git show ":$f" | pdftotext -q - - 2>/dev/null) ;;
    *) continue ;;
  esac
  if ! printf '%s' "$conteudo" | python3 "$mascara" --check - >/dev/null; then
    echo "[AVISO] Dado sensível sem máscara: $f"
    avisos=1
  fi
done < <(git diff --cached --name-only --diff-filter=AM -- 'semanas/*' 'docs/*' 'templates/*')
[ -n "$avisos" ] && echo "  Commit permitido. Para mascarar textos: python3 scripts/mascarar_dados.py <arquivos> (PDFs: regerar a partir da fonte mascarada)."

if [ $fail -ne 0 ]; then
  echo "Commit cancelado. Para ignorar conscientemente: git commit --no-verify"
fi
exit $fail
