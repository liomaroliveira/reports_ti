#!/usr/bin/env bash
# Bloqueia apenas: dados do WhatsApp e chaves de API nas linhas adicionadas (verificação rápida, só git diff + grep).
# Não há detecção de dados pessoais (decisão de 2026-10-19: repositório de uso interno; máscara manual e opcional
# com scripts/mascarar_dados.py).
# Ativação (uma vez por clone): git config core.hooksPath .githooks

fail=0

# 1. Arquivos do WhatsApp que não sejam README/scripts
bad_paths=$(git diff --cached --name-only --diff-filter=AM \
  | grep -E '^miscelaneous/whatsapp_histories/' \
  | grep -vE '^miscelaneous/whatsapp_histories/(README\.md|scripts/[^/]+\.py)$')
if [ -n "$bad_paths" ]; then
  echo "[BLOQUEADO] Dados do WhatsApp não podem ser versionados:"
  echo "$bad_paths" | sed 's/^/  /'
  fail=1
fi

# 2. Chaves de API nas linhas adicionadas (ignora PDFs e arquivos binários)
hits=$(git diff --cached -U0 --diff-filter=AM --no-ext-diff -- . ':(exclude)*.pdf' \
  | grep -E '^\+[^+]' | grep -oE 'sk-[A-Za-z0-9_-]{16,}' | sort -u | head -5)
if [ -n "$hits" ]; then
  echo "[BLOQUEADO] Chave de API encontrada nas linhas adicionadas (amostra):"
  echo "$hits" | sed -E 's/^(.{6}).*/  \1…/'
  fail=1
fi

[ $fail -ne 0 ] && echo "Commit cancelado. Para ignorar conscientemente: git commit --no-verify"
exit $fail
